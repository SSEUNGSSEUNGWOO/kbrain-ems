# OS
.DS_Store

# Logs
*.log

# Env safety (each subproject also has its own .gitignore)
.env
.env.local
.env.*.local

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Generated cohort reports (운영자가 검수 후 별도 배포)
/reports/

# 일회성 스크립트·덤프·점검용 임시 산출물 (커밋 대상 아님)
/tmp_*
/frontend/tmp_*
/doc-audit/
/dev-log-*.md

# 한컴 자동 저장 파일
*.hop-save-*.tmp
*.gul

# 한컴 결과보고서 (별도 송부·외부 관리)
*.hwp

# 운영 자료 (별도 공유, 리포지토리 외부에서 관리)
/docs/0529/
/docs/최종/
/assistant_instructor_schedule.xlsx
/보조강사_필요회차_*.xlsx

# 일회성 스크립트 아카이브 — 실명·로컬 절대경로 하드코딩 다수, 로컬 보관만
frontend/scripts/archive/

# 운영 중 생성되는 점검·백업 산출물 (로컬 보관)
/tools/

# 개인정보 포함 백업·산출물 (DB 복구용 로컬 보관)
__pycache__/
docs/*.xlsx
docs/2차선발/
docs/0529/
docs/최종/
docs/*.hwp

# 개인정보 포함 데이터 덤프 — 절대 커밋 금지
frontend/scripts/**/tmp_*.json
frontend/scripts/**/_*-dump.txt
frontend/scripts/**/_*-out.txt
frontend/scripts/**/*-applicants.json
frontend/scripts/**/*-roster.json
*.xls
*.xlsx
