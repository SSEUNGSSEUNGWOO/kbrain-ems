# Supabase — 프로젝트 대시보드 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only — RLS를 우회하는 마스터 키. 클라이언트 번들에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# 과제 자동채점 등 LLM 호출용
OPENAI_API_KEY=

# (선택) import 스크립트에서 제외할 운영진 테스트 계정 이메일 — 쉼표 구분
IMPORT_TEST_EMAILS=

# 자동선발 개별지정 대상 (comma 구분 실명)
FORCE_SELECT_NAMES=

# 사전학습 안내 운영팀 연락처 (comma 구분)
INQUIRY_PHONES_GENERAL=
INQUIRY_PHONES_CHAMPION=

# 문자 발송(타스온). 셋 중 하나라도 비면 자동으로 드라이런 — 실제 전송 없이 이력만 남는다.
TASON_ID=
TASON_AUTH_KEY=
TASON_SENDER=
TASON_SENDER_NAME=
# 키가 다 있어도 드라이런으로 묶어두는 스위치
TASON_DRY_RUN=true

# Vercel Cron 인증. /api/cron/* 이 Authorization: Bearer <값> 으로 대조한다.
CRON_SECRET=
